{
  "version": 1,
  "author": "Raksyz - SIPGURU Team",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-dev-kit-c",
      "id": "esp32",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-ssd1306",
      "id": "oled1",
      "top": 100,
      "left": 200,
      "attrs": {
        "i2cAddress": "0x3C"
      }
    },
    {
      "type": "wokwi-button",
      "id": "btn1",
      "top": 250,
      "left": 100,
      "attrs": {
        "color": "green",
        "label": "Refresh QR"
      }
    }
  ],
  "connections": [
    ["esp32:TX", "$serial1:RX"],
    ["esp32:RX", "$serial1:TX"],
    ["esp32:SDA", "oled1:SDA"],
    ["esp32:SCL", "oled1:SCL"],
    ["esp32:V5", "oled1:VCC"],
    ["esp32:GND", "oled1:GND"],
    ["esp32:GND", "btn1:1"],
    ["esp32:GPIO4", "btn1:2"]
  ]
}
