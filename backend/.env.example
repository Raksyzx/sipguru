# SIPGURU Backend Environment Variables for Railway
# Copy ke Railway Dashboard → Variables → Add Variable

# Development Mode
# 0 = Production (Supabase), 1 = Development (SQLite)
DEVELOPMENT=0

# Supabase (wajib untuk production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-32-character-minimum-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# App
APP_NAME="SIPGURU"
APP_URL=https://sipguru-six.vercel.app

# Optional: Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=